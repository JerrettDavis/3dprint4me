# Public origin used for checkout return URLs and links.
SITE_URL=https://3dprint4.me

# Supabase: server-only service role key. Never expose this in browser code.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=service-files

# Current free production stack: Neon Postgres plus a private Vercel Blob store.
# Both are server-only; connect them to the Vercel project in Production.
DATABASE_URL=postgresql://...
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Managed Neon Auth for the private operator API. GitHub is configured in Neon.
NEON_AUTH_BASE_URL=https://YOUR_BRANCH.neonauth.REGION.aws.neon.tech
NEON_AUTH_JWKS_URL=https://YOUR_BRANCH.neonauth.REGION.aws.neon.tech/.well-known/jwks.json
OPERATOR_ALLOWED_ORIGINS=http://127.0.0.1:4180

# Email via Resend. Both addresses should use verified domains in production.
RESEND_API_KEY=re_...
REQUEST_FROM_EMAIL=3dprint4.me <requests@3dprint4.me>
REQUEST_TO_EMAIL=hello@3dprint4.me

# Optional automation webhook. Signature: X-3DP-Signature: sha256=<hex>.
REQUEST_WEBHOOK_URL=https://example.com/hooks/3dprint4me
REQUEST_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Optional Stripe Checkout deposit.
STRIPE_SECRET_KEY=sk_test_...
DEPOSIT_AMOUNT_CENTS=2500

# Development server only.
LOCAL_DEV=1
HOST=127.0.0.1
PORT=4173
