# Public origin used for checkout return URLs and links.
SITE_URL=https://3dprint4.me

# Supabase: server-only service role key. Never expose this in browser code.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=service-files

# Current free production stack: Neon Postgres plus a private Vercel Blob store.
# Both are server-only; connect them to the Vercel project in Production.
DATABASE_URL=postgresql://...
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Managed Neon Auth for the private operator API. GitHub is configured in Neon.
NEON_AUTH_BASE_URL=https://YOUR_BRANCH.neonauth.REGION.aws.neon.tech
NEON_AUTH_JWKS_URL=https://YOUR_BRANCH.neonauth.REGION.aws.neon.tech/.well-known/jwks.json
OPERATOR_ALLOWED_ORIGINS=http://127.0.0.1:4180
OPERATOR_PORT=4180

# Read-only Home Assistant work snapshot. Server-only; store the matching Bearer value in HA secrets.yaml.
HOME_ASSISTANT_TOKEN=replace-with-at-least-32-random-characters

# Web Push: public key may be sent to authenticated operator clients; others stay server-only.
VAPID_SUBJECT=mailto:hello@3dprint4.me
VAPID_PUBLIC_KEY=replace-with-generated-public-key
VAPID_PRIVATE_KEY=replace-with-generated-private-key
PUSH_WORKER_SECRET=replace-with-a-long-random-secret
PUSH_WORKER_URL=https://YOUR_FUNCTION.neon.run/

# Print estimation (optional overrides; defaults shown). Uses DATABASE_URL + BLOB_READ_WRITE_TOKEN.
PRINT_ESTIMATE_MAX_BYTES=26214400
PRINT_ESTIMATE_MAX_TRIANGLES=1500000
PRINT_ESTIMATE_MAX_3MF_ENTRIES=256
PRINT_ESTIMATE_MAX_3MF_UNCOMPRESSED_BYTES=134217728
# STL/3MF parts accepted from one ZIP model pack (clamped to 32)
PRINT_ESTIMATE_MAX_PACK_PARTS=16
PRINT_ESTIMATE_SESSION_TTL_HOURS=24
PRINT_ESTIMATE_MAX_ASSETS=3
PRINT_ESTIMATE_MAX_ESTIMATES=20
PRINT_ESTIMATE_SESSIONS_PER_CLIENT=10
PRINT_ESTIMATE_SESSIONS_GLOBAL=300
PRINT_ESTIMATE_UPLOADS_PER_CLIENT=30
PRINT_ESTIMATE_UPLOADS_GLOBAL=900
PRINT_ESTIMATE_RATE_WINDOW_SECONDS=3600
PRINT_ASSET_RETENTION_DAYS=90

# Exact slicing is optional and asynchronous. Leave SLICER_PROVIDER empty to disable.
# local-cli: PrusaSlicer-compatible binary run by `npm run estimate:worker`.
SLICER_PROVIDER=
SLICER_BIN=/usr/bin/prusa-slicer
SLICER_PROFILE=/etc/3dprint4me/pla-0.20mm.ini
SLICER_PROFILE_ID=pla-0.20mm-standard
SLICER_TIMEOUT_MS=120000
# http: separately hosted worker; server-only bearer token of at least 32 characters.
SLICER_HTTP_URL=https://slicer.example.com/estimate
SLICER_HTTP_TOKEN=replace-with-a-long-random-secret

# Email via Resend. Both addresses should use verified domains in production.
RESEND_API_KEY=re_...
REQUEST_FROM_EMAIL=3dprint4.me <requests@3dprint4.me>
REQUEST_TO_EMAIL=hello@3dprint4.me

# Optional automation webhook. Signature: X-3DP-Signature: sha256=<hex>.
REQUEST_WEBHOOK_URL=https://example.com/hooks/3dprint4me
REQUEST_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Optional Stripe Checkout deposit.
STRIPE_SECRET_KEY=sk_test_...
DEPOSIT_AMOUNT_CENTS=2500

# Development server only.
LOCAL_DEV=1
HOST=127.0.0.1
PORT=4173
