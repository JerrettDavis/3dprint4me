{
  "name": "3dprint4me",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Accessible storefront and guided project intake for custom 3D modeling, printing, printer repair, tuning, and fabrication.",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "dev:workspace": "node scripts/dev-workspace.mjs",
    "operator:build": "node scripts/build-operator-auth.mjs",
    "assets:version": "node scripts/version-assets.mjs",
    "validate": "node scripts/build-review-reader.mjs --check && node scripts/version-assets.mjs --check && node scripts/validate.mjs",
    "test:e2e": "python -m pytest tests/e2e -q",
    "audit": "python tests/audit/audit.py",
    "screenshots": "python scripts/capture_screenshots.py",
    "smoke:live": "node scripts/smoke-live.mjs",
    "estimate:cleanup": "node scripts/print-estimate-maintenance.mjs",
    "estimate:worker": "node scripts/print-estimate-worker.mjs",
    "test": "npm run customizer:build && npm run validate && npm run test:unit && npm run test:e2e && npm run audit",
    "vercel-build": "node scripts/vercel-build.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs tests/contract/*.test.mjs",
    "customizer:build": "vite build --config customizer/vite.config.js",
    "customizer:dev": "vite --config customizer/vite.config.js",
    "test:partner:postgres": "node --test tests/integration/partner-postgres.test.mjs",
    "test:partner:browser": "python -m pytest tests/integration/test_partner_native_browser.py tests/integration/test_partner_budget_browser.py tests/integration/test_partner_auth_browser.py tests/integration/test_partner_gig_browser.py tests/integration/test_partner_consent_referral_browser.py tests/integration/test_partner_forecast_browser.py tests/integration/test_partner_statement_browser.py tests/integration/test_partner_owner_control_browser.py -q",
    "review:reader:build": "node scripts/build-review-reader.mjs"
  },
  "homepage": "https://3dprint4.me",
  "keywords": [
    "3d-printing",
    "3d-modeling",
    "fabrication",
    "supabase",
    "vercel",
    "stripe",
    "accessible"
  ],
  "dependencies": {
    "@neon/config": "^1.7.2",
    "@neondatabase/auth": "^0.5.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "jose": "^6.2.5",
    "openid-client": "6.8.8",
    "pg": "^8.23.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "esbuild": "^0.28.0",
    "jsqr": "1.4.0",
    "manifold-3d": "3.5.4",
    "opentype.js": "2.0.0",
    "qrcode-generator": "2.0.4",
    "three": "0.170.0",
    "vite": "8.3.5"
  },
  "overrides": {
    "zod": "4.6.6",
    "undici": "6.29.1"
  }
}
