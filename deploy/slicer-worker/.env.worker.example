# Copy to deploy/slicer-worker/.env.worker on the Docker host and fill in real values.
# .env.worker is git-ignored; never commit it. Docker env_file values are NOT quoted.
# Values here override the image's ENV defaults, so keep only the block for the image you build.

# Same Neon connection string the storefront uses (DATABASE_URL).
DATABASE_URL=
# Same private Vercel Blob read/write token the storefront uses.
BLOB_READ_WRITE_TOKEN=

# ---- Bambu Studio CLI (Dockerfile.bambu, the compose default) ----
# Binary, preset paths, filament map and bed type are baked into the image; override only if needed.
SLICER_PROVIDER=bambu-cli
SLICER_ENGINE=bambu-studio-cli
# Recorded on each estimate (":<material>" is appended); change it whenever the presets change.
SLICER_PROFILE_ID=bambu-x2d-0.4-0.16hq-generic-v1
SLICER_TIMEOUT_MS=300000
# SLICER_BED_TYPE=Textured PEI Plate
# SLICER_FILAMENT_PROFILES=pla=/app/profiles/filament-pla.json;petg=/app/profiles/filament-petg.json;asa=/app/profiles/filament-asa.json;tpu=/app/profiles/filament-tpu.json

# ---- PrusaSlicer CLI (Dockerfile; build with SLICER_DOCKERFILE=Dockerfile) ----
# SLICER_PROVIDER=local-cli
# SLICER_BIN=/opt/prusaslicer/AppRun
# SLICER_PROFILE=/app/profiles/default.ini
# SLICER_PROFILE_ID=placeholder-default-v1
# SLICER_ENGINE=prusaslicer-cli
# SLICER_TIMEOUT_MS=300000

# Optional: idle poll interval in ms (default 15000).
# SLICER_POLL_MS=15000
