# Merge these server-only values into the private API/jobs environments, never replace unrelated keys.
# Read-only tracking is independent of INVOICE_NINJA_ENABLED (website draft creation).
INVOICE_TRACKING_ENABLED=0
INVOICE_NINJA_GROUP_ID=REPLACE_WITH_VERIFIED_FABRICATION_GROUP
INVOICE_NINJA_TOKEN=REUSE_EXISTING_PRIVATE_PROVIDER_CREDENTIAL

# Outbound persistent notifications use a distinct private Home Assistant credential.
# API only needs tracking fields; these delivery fields belong in jobs.env.
HOME_ASSISTANT_BILLING_ORIGIN=https://YOUR_PRIVATE_HOME_ASSISTANT_HOST
HOME_ASSISTANT_BILLING_TOKEN=REPLACE_PRIVATELY
