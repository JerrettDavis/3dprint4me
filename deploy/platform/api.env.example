# Copy OUTSIDE the repository to the owner-private platform root as api.env.
# bootstrap-host.py writes database URLs and identity selection from private inputs.
NODE_ENV=production
PORT=8080
SITE_URL=https://3dprint4.me
DATABASE_DRIVER=postgres
OPERATOR_AUTH_PROVIDER=github
PLATFORM_TARGET_AUTH_PROVIDER=github
OPERATOR_API_ORIGIN=https://api.3dprint4.me
OPERATOR_WEB_ORIGIN=https://work.3dprint4.me
OPERATOR_ALLOWED_ORIGINS=https://work.3dprint4.me
OPERATOR_OWNER_SUBJECT=2610199
GITHUB_CLIENT_ID=REPLACE_PRIVATELY
GITHUB_CLIENT_SECRET=REPLACE_PRIVATELY
PLATFORM_PROXY_SECRET=REPLACE_PRIVATELY_WITH_48_RANDOM_BYTES
BLOB_READ_WRITE_TOKEN=REPLACE_PRIVATELY
HOME_ASSISTANT_TOKEN=REPLACE_PRIVATELY
VAPID_SUBJECT=mailto:hello@3dprint4.me
VAPID_PUBLIC_KEY=REPLACE_PRIVATELY
VAPID_PRIVATE_KEY=REPLACE_PRIVATELY
PUSH_WORKER_SECRET=REPLACE_PRIVATELY
RESEND_API_KEY=REPLACE_PRIVATELY
REQUEST_FROM_EMAIL=3dprint4.me <requests@3dprint4.me>
REQUEST_TO_EMAIL=hello@3dprint4.me
INVOICE_NINJA_ENABLED=0
INQUIRY_WORKFLOW_ENABLED=1
SLICER_PROVIDER=bambu-cli

# Partner portal engagement stays disabled until recorded counsel/CPA reviews
# and explicit owner activation. These switches alone cannot grant clearance.
PARTNER_WEB_ORIGIN=https://partners.3dprint4.me
PARTNER_PROGRAM_ENABLED=0
PARTNER_CLASSIFICATION_APPROVED=0
PARTNER_ACCOUNTING_APPROVED=0

# Optional private Ed25519 PKCS8 PEM for review-package signing; never browser/Vercel public env.
# Store actual multiline value using the host secret environment mechanism.
PARTNER_REVIEW_SIGNING_PRIVATE_KEY=
